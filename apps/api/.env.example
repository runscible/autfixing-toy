# Copy to .env to let onNewError create a GitHub issue and fire the
# repository_dispatch that the autofix workflow listens for.
# Without these, errors are still deduplicated locally — GitHub reporting
# is just skipped with a log line.

# Personal access token with permission to create issues and dispatch
# repository events on GITHUB_REPOSITORY below.
GITHUB_TOKEN=

# "owner/repo", same format GitHub Actions exposes as $GITHUB_REPOSITORY.
GITHUB_REPOSITORY=
